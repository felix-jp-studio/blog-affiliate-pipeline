{
  "name": "blog-affiliate-pipeline",
  "private": true,
  "description": "格安SIM×光回線アフィリエイトの記事生成・WordPress投稿パイプライン",
  "type": "module",
  "workspaces": [
    "packages/publisher"
  ],
  "scripts": {
    "wp:ping": "npm run wp:ping -w @blog-affiliate/publisher",
    "wp:post": "npm run wp:post -w @blog-affiliate/publisher",
    "test": "npm run test -w @blog-affiliate/publisher && npm run test:generator && npm run test:affiliate && npm run test:comments && npm run test:gsc",
    "test:generator": "cd packages/generator && PYTHONPATH=. python3 -m unittest discover -s tests -q",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "generate:test": "PYTHONPATH=packages/generator python3 -m generator --mode auto",
    "generate:template": "PYTHONPATH=packages/generator python3 -m generator --mode template",
    "generate:batch": "PYTHONPATH=packages/generator python3 -m generator --batch config/batch-priority-27-35.json --mode auto",
    "publish:scheduled": "PYTHONPATH=packages/generator python3 -m generator publish-scheduled",
    "test:e2e:local": "bash scripts/e2e/run-local-e2e.sh --mode template",
    "test:e2e": "node scripts/e2e/validate-articles.mjs && npm run build --prefix site && node scripts/e2e/validate-dist.mjs",
    "test:e2e:articles": "node scripts/e2e/validate-articles.mjs",
    "test:e2e:dist": "node scripts/e2e/validate-dist.mjs",
    "test:e2e:smoke": "node scripts/e2e/smoke-production.mjs",
    "test:e2e:cwv": "npx --yes @lhci/cli@0.14.0 autorun",
    "test:e2e:indexnow": "node scripts/e2e/verify-indexnow-key.mjs",
    "test:e2e:changed-slugs": "node scripts/e2e/changed-slugs.mjs",
    "indexnow:ping": "node scripts/indexnow-ping.mjs",
    "gsc:inspection-batch": "node scripts/print-gsc-inspection-batch.mjs",
    "gsc:auth:login": "node scripts/gsc/auth-login.mjs",
    "gsc:auth:login:legacy": "node scripts/gsc/export-playwright-session.mjs",
    "gsc:inspect-batch": "node scripts/gsc/inspect-batch.mjs",
    "gsc:verify-access": "node scripts/gsc/verify-access.mjs",
    "gsc:verify-ui": "node scripts/gsc/verify-ui-session.mjs",
    "audit:orphans": "node scripts/audit-orphan-articles.mjs",
    "audit:hub-mesh": "node scripts/audit-hub-mesh-coverage.mjs",
    "sync:hub-mesh": "node scripts/sync-hub-mesh-from-articles.mjs",
    "backfill:date-modified": "node scripts/backfill-date-modified.mjs",
    "backfill:internal-links": "python3 scripts/backfill-internal-links.py --force",
    "post-publish:onboard": "node scripts/post-publish-article-onboard.mjs",
    "gsc:weekly-report": "node scripts/gsc-weekly-report.mjs",
    "gsc:weekly-log": "node scripts/gsc/generate-weekly-log.mjs",
    "gsc:index-queue-status": "node scripts/gsc/index-queue-status.mjs",
    "gsc:import-rewrite-queue": "node scripts/gsc-import-rewrite-queue.mjs",
    "rewrite:weekly": "node scripts/rewrite-weekly.mjs",
    "seed:rewrite-queue": "node scripts/seed-rewrite-queue-heuristic.mjs",
    "scraper:hikari": "cd packages/scraper && PYTHONPATH=. .venv/bin/python -m scraper.hikari_prices",
    "scraper:hikari:fixture": "cd packages/scraper && PYTHONPATH=. .venv/bin/python -m scraper.hikari_prices --fixture-dir tests/fixtures",
    "test:scraper": "cd packages/scraper && PYTHONPATH=. .venv/bin/python -m unittest discover -s tests -q",
    "price-diff:rewrite-hook": "node scripts/price-diff-rewrite-hook.mjs",
    "price-diff:rewrite-hook:dry-run": "node scripts/price-diff-rewrite-hook.mjs --dry-run",
    "report:article-type-ratio": "node scripts/report-article-type-ratio.mjs",
    "test:e2e:visual": "npm run test:e2e:visual --prefix site",
    "test:e2e:visual:update": "npm run test:e2e:visual:update --prefix site",
    "test:e2e:visual:docker": "bash scripts/e2e/update-visual-baselines-docker.sh verify",
    "test:e2e:visual:update:docker": "bash scripts/e2e/update-visual-baselines-docker.sh update",
    "test:e2e:all": "npm run test:e2e && npm run test:e2e:visual",
    "test:comments": "npm run test:unit --prefix site",
    "test:gsc": "node --test scripts/gsc/*.test.mjs",
    "test:visitability": "node --test scripts/visitability/*.test.mjs",
    "test:refactor-pdca": "node --test scripts/refactor-pdca/*.test.mjs",
    "visitability:metrics": "node scripts/visitability/collect-metrics.mjs",
    "visitability:plan": "node scripts/visitability/plan-cycle.mjs",
    "visitability:run": "node scripts/visitability/run-cycle.mjs",
    "refactor:metrics": "node scripts/refactor-pdca/collect-refactor-metrics.mjs",
    "refactor:plan": "node scripts/refactor-pdca/plan-refactor.mjs",
    "refactor:plan:dry-run": "node scripts/refactor-pdca/plan-refactor.mjs --dry-run",
    "test:ux-pdca": "node --test scripts/ux-pdca/*.test.mjs",
    "ux:metrics": "node scripts/ux-pdca/collect-ux-metrics.mjs",
    "ux:plan": "node scripts/ux-pdca/plan-ux-cycle.mjs",
    "affiliate:intake": "node scripts/affiliate/intake-urls.mjs",
    "affiliate:intake:dry-run": "node scripts/affiliate/intake-urls.mjs --dry-run",
    "affiliate:migrate": "node scripts/affiliate/migrate-article-links.mjs",
    "affiliate:migrate:dry-run": "node scripts/affiliate/migrate-article-links.mjs --dry-run",
    "affiliate:health": "node scripts/affiliate/link-health-check.mjs",
    "affiliate:health:dry-run": "node scripts/affiliate/link-health-check.mjs --dry-run",
    "test:affiliate": "node --test scripts/affiliate/*.test.mjs",
    "docs:design-html": "node scripts/docs/md-design-to-html.mjs",
    "comments:moderate": "npm run comments:moderate --prefix site"
  },
  "devDependencies": {
    "marked": "^15.0.12",
    "playwright": "^1.61.1",
    "prettier": "^3.5.3"
  }
}
