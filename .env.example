# GitHub bot（Cursor エージェント + scheduled-articles PR/approve 用）
# 実際の値は .env.local に保存（gitignore 済み）。Actions Secrets にも GITHUB_BOT_TOKEN で登録。
# GITHUB_BOT_TOKEN=

# WordPress
WP_URL=https://example.jp
WP_USER=admin
WP_APP_PASSWORD=

# 投稿制限
MAX_POSTS_PER_RUN=1
PUBLISH_STATE_PATH=state/publish-state.json

# IndexNow（記事マージ後 ping / Vercel キーファイル生成）
# INDEXNOW_KEY=

# GSC API / 日次検査バッチ（値は入れない。Actions Secrets に登録）
# GSC_SITE_URL=https://sim-hikari-guide.com/
# GSC_SERVICE_ACCOUNT_JSON=
# GSC_OAUTH_CLIENT_ID=
# GSC_OAUTH_CLIENT_SECRET=
# GSC_OAUTH_REFRESH_TOKEN=
# GSC_PLAYWRIGHT_STORAGE_STATE=   # base64(JSON) — npm run gsc:auth:login で生成
# GSC_PLAYWRIGHT_STORAGE_PATH=    # ローカル: gsc-playwright-auth.json

# 生成（Phase 1）
# GROQ_API_KEY=
# GROQ_MODEL_DEV=llama-3.1-8b-instant
# GROQ_MODEL_PROD=llama-3.3-70b-versatile
