---
import type { BreadcrumbItem } from "../data/site-nav";

interface Props {
  items: BreadcrumbItem[];
}

const { items } = Astro.props;
---

<nav aria-label="パンくずリスト" class="breadcrumbs">
  <ol>
    {
      items.map((item, index) => {
        const isLast = index === items.length - 1;
        return (
          <li>
            {item.href && !isLast ? (
              <a href={item.href}>{item.label}</a>
            ) : (
              <span
                aria-current={isLast ? "page" : undefined}
                class={isLast ? "breadcrumbs__current" : undefined}
                title={isLast ? item.label : undefined}
              >
                {item.label}
              </span>
            )}
          </li>
        );
      })
    }
  </ol>
</nav>

<style>
  .breadcrumbs {
    margin-bottom: 1.25rem;
    font-size: 0.875rem;
    color: var(--muted);
  }

  ol {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: 0.35rem;
    list-style: none;
    margin: 0;
    padding: 0;
  }

  /* min-width lets a long crumb shrink below its text width so it can ellipsize
     instead of pushing the row past the viewport. */
  li {
    display: flex;
    align-items: baseline;
    min-width: 0;
  }

  li:not(:last-child)::after {
    content: "›";
    margin-left: 0.35rem;
    color: var(--border);
  }

  a {
    color: var(--muted);
  }

  a:hover {
    color: var(--accent);
  }

  span[aria-current="page"] {
    color: var(--text);
  }

  /* The current page is the only crumb that can be long: clip it to whatever the
     row has left rather than to a fixed character count. */
  .breadcrumbs__current {
    display: block;
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
    max-width: 100%;
  }

  @media (min-width: 640px) {
    .breadcrumbs__current {
      overflow: visible;
      white-space: normal;
    }
  }
</style>
