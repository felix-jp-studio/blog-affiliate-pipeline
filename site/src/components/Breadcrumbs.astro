---
import type { BreadcrumbItem } from "../data/site-nav";

interface Props {
  items: BreadcrumbItem[];
}

const { items } = Astro.props;

const MAX_CURRENT_LABEL = 28;

function truncateLabel(label: string, maxLength: number): string {
  if (label.length <= maxLength) return label;
  return `${label.slice(0, maxLength)}…`;
}
---

<nav aria-label="パンくずリスト" class="breadcrumbs">
  <ol>
    {
      items.map((item, index) => {
        const isLast = index === items.length - 1;
        return (
          <li>
            {item.href && !isLast ? (
              <a href={item.href}>{item.label}</a>
            ) : (
              <span
                aria-current={isLast ? "page" : undefined}
                class={isLast ? "breadcrumbs__current" : undefined}
                title={
                  isLast && item.label.length > MAX_CURRENT_LABEL
                    ? item.label
                    : undefined
                }
              >
                {isLast
                  ? truncateLabel(item.label, MAX_CURRENT_LABEL)
                  : item.label}
              </span>
            )}
          </li>
        );
      })
    }
  </ol>
</nav>

<style>
  .breadcrumbs {
    margin-bottom: 1.25rem;
    font-size: 0.875rem;
    color: var(--muted);
  }

  ol {
    display: flex;
    flex-wrap: wrap;
    gap: 0.35rem;
    list-style: none;
    margin: 0;
    padding: 0;
  }

  li:not(:last-child)::after {
    content: "›";
    margin-left: 0.35rem;
    color: var(--border);
  }

  a {
    color: var(--muted);
  }

  a:hover {
    color: var(--accent);
  }

  span[aria-current="page"] {
    color: var(--text);
  }

  .breadcrumbs__current {
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
    max-width: min(100%, 16rem);
  }

  @media (min-width: 640px) {
    .breadcrumbs__current {
      max-width: none;
      white-space: normal;
    }
  }
</style>
