---
const gaId = import.meta.env.PUBLIC_GA_MEASUREMENT_ID;
---

{
  gaId && (
    <script
      is:inline
      set:html={`(function(){var id='${gaId}';var COOKIE='ga_internal=1';var PARAM='ga_internal';function isInternalHost(h){return h==='localhost'||h==='127.0.0.1'||h.endsWith('.vercel.app');}function hasInternalOptOut(){try{var p=new URLSearchParams(location.search);if(p.get(PARAM)==='1'){document.cookie=COOKIE+'; path=/; max-age=31536000; SameSite=Lax';return true;}return document.cookie.indexOf(COOKIE)!==-1;}catch(e){return false;}}function trafficType(){if(isInternalHost(location.hostname)||hasInternalOptOut())return'internal';}function loadGA(){var s=document.createElement('script');s.async=true;s.src='https://www.googletagmanager.com/gtag/js?id='+id;document.head.appendChild(s);window.dataLayer=window.dataLayer||[];function gtag(){dataLayer.push(arguments);}window.gtag=gtag;gtag('js',new Date());var cfg={};var tt=trafficType();if(tt)cfg.traffic_type=tt;gtag('config',id,cfg);}if('requestIdleCallback' in window){requestIdleCallback(loadGA,{timeout:4000});}else{window.addEventListener('load',function(){setTimeout(loadGA,0);});}})();`}
    />
  )
}
