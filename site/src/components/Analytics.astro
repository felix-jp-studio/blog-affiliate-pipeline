---
const gaId = import.meta.env.PUBLIC_GA_MEASUREMENT_ID;
---

{
  gaId && (
    <script
      is:inline
      set:html={`(function(){var id='${gaId}';function loadGA(){var s=document.createElement('script');s.async=true;s.src='https://www.googletagmanager.com/gtag/js?id='+id;document.head.appendChild(s);window.dataLayer=window.dataLayer||[];function gtag(){dataLayer.push(arguments);}window.gtag=gtag;gtag('js',new Date());gtag('config',id);}if('requestIdleCallback' in window){requestIdleCallback(loadGA,{timeout:4000});}else{window.addEventListener('load',function(){setTimeout(loadGA,0);});}})();`}
    />
  )
}
