---
const formAction = import.meta.env.PUBLIC_CONTACT_FORM_ACTION;
const contactEmail = import.meta.env.PUBLIC_CONTACT_EMAIL ?? "";
---

<section class="contact-form" aria-labelledby="contact-form-heading">
  {
    formAction ? (
      <>
        <h2 id="contact-form-heading" class="contact-form__heading">
          お問い合わせフォーム
        </h2>
        <div
          class="form-status"
          role="status"
          aria-live="polite"
          tabindex="-1"
          data-form-status
          hidden
        />
        <form
          class="contact-form__form"
          method="post"
          action={formAction}
          data-contact-form
          data-form-action={formAction}
          aria-label="お問い合わせフォーム"
          novalidate
        >
          <div class="field">
            <label class="field-label" for="name">
              お名前
              <span class="field-label__required" aria-hidden="true">
                必須
              </span>
            </label>
            <input
              id="name"
              name="name"
              type="text"
              required
              aria-required="true"
              maxlength="100"
              autocomplete="name"
              aria-describedby="name-error"
            />
            <p
              class="field-error"
              id="name-error"
              data-field-error="name"
              role="alert"
              hidden
            />
          </div>
          <div class="field">
            <label class="field-label" for="email">
              メールアドレス
              <span class="field-label__required" aria-hidden="true">
                必須
              </span>
            </label>
            <input
              id="email"
              name="email"
              type="email"
              required
              aria-required="true"
              maxlength="254"
              autocomplete="email"
              inputmode="email"
              aria-describedby="email-error"
            />
            <p
              class="field-error"
              id="email-error"
              data-field-error="email"
              role="alert"
              hidden
            />
          </div>
          <div class="field">
            <label class="field-label" for="message">
              お問い合わせ内容
              <span class="field-label__required" aria-hidden="true">
                必須
              </span>
            </label>
            <textarea
              id="message"
              name="message"
              rows="6"
              required
              aria-required="true"
              minlength="10"
              maxlength="2000"
              aria-describedby="message-error message-hint"
            />
            <p class="field-hint" id="message-hint">
              10文字以上、2,000文字以内でご入力ください。
            </p>
            <p
              class="field-error"
              id="message-error"
              data-field-error="message"
              role="alert"
              hidden
            />
          </div>
          <button type="submit" data-submit-button>
            <span class="btn-label">送信する</span>
            <span class="btn-loading" aria-hidden="true" hidden>
              <span class="btn-spinner" />
              送信中…
            </span>
          </button>
        </form>
      </>
    ) : (
      <p class="notice">
        フォーム送信先の設定が完了次第、こちらからお問い合わせいただけます。
        {contactEmail && (
          <>
            {" "}
            それまでのご連絡は{" "}
            <a href={`mailto:${contactEmail}`}>{contactEmail}</a>{" "}
            までお願いします。
          </>
        )}
      </p>
    )
  }
</section>

<script>
  const form = document.querySelector("[data-contact-form]");
  if (form) {
    const formAction = form.dataset.formAction || form.action;
    const statusEl = document.querySelector("[data-form-status]");
    const submitButton = form.querySelector("[data-submit-button]");
    const btnLabel = submitButton && submitButton.querySelector(".btn-label");
    const btnLoading =
      submitButton && submitButton.querySelector(".btn-loading");
    const fieldErrors = Array.from(form.querySelectorAll("[data-field-error]"));

    const emailPattern = /^[^\s@]+@[^\s@]+\.[^\s@]+$/;

    const validators = {
      name(value) {
        const trimmed = value.trim();
        if (!trimmed) return "お名前を入力してください。";
        if (trimmed.length > 100) {
          return "お名前は100文字以内で入力してください。";
        }
        return null;
      },
      email(value) {
        const trimmed = value.trim();
        if (!trimmed) return "メールアドレスを入力してください。";
        if (trimmed.length > 254) {
          return "メールアドレスは254文字以内で入力してください。";
        }
        if (!emailPattern.test(trimmed)) {
          return "有効なメールアドレスを入力してください。";
        }
        return null;
      },
      message(value) {
        const trimmed = value.trim();
        if (!trimmed) return "お問い合わせ内容を入力してください。";
        if (trimmed.length < 10) {
          return "お問い合わせ内容は10文字以上で入力してください。";
        }
        if (trimmed.length > 2000) {
          return "お問い合わせ内容は2,000文字以内で入力してください。";
        }
        return null;
      },
    };

    const setFieldError = (field, message) => {
      const input = form.querySelector(`[name="${field}"]`);
      const errorEl = fieldErrors.find((el) => el.dataset.fieldError === field);
      if (!input || !errorEl) return;

      if (message) {
        input.setAttribute("aria-invalid", "true");
        errorEl.textContent = message;
        errorEl.hidden = false;
      } else {
        input.removeAttribute("aria-invalid");
        errorEl.textContent = "";
        errorEl.hidden = true;
      }
    };

    const validateField = (field) => {
      const input = form.querySelector(`[name="${field}"]`);
      if (!input) return true;
      const error = validators[field](input.value);
      setFieldError(field, error);
      return error === null;
    };

    const validateForm = () =>
      ["name", "email", "message"].map(validateField).every(Boolean);

    const setFormStatus = (type, message = "") => {
      if (!statusEl) return;
      statusEl.classList.remove("is-success", "is-error");
      if (!type) {
        statusEl.hidden = true;
        statusEl.textContent = "";
        return;
      }
      statusEl.hidden = false;
      statusEl.textContent = message;
      statusEl.classList.add(type === "success" ? "is-success" : "is-error");
    };

    const setLoading = (loading) => {
      if (!submitButton || !btnLabel || !btnLoading) return;
      submitButton.disabled = loading;
      submitButton.setAttribute("aria-busy", loading ? "true" : "false");
      btnLabel.hidden = loading;
      btnLoading.hidden = !loading;
    };

    ["name", "email", "message"].forEach((field) => {
      const input = form.querySelector(`[name="${field}"]`);
      if (input) {
        input.addEventListener("blur", () => validateField(field));
        input.addEventListener("input", () => {
          if (input.getAttribute("aria-invalid") === "true") {
            validateField(field);
          }
        });
      }
    });

    form.addEventListener("submit", async (event) => {
      event.preventDefault();
      setFormStatus(null);

      if (!validateForm()) {
        const firstInvalid = form.querySelector("[aria-invalid='true']");
        if (firstInvalid && "focus" in firstInvalid) {
          firstInvalid.focus();
        }
        setFormStatus(
          "error",
          "入力内容をご確認のうえ、もう一度お試しください。",
        );
        return;
      }

      setLoading(true);

      try {
        const response = await fetch(formAction, {
          method: "POST",
          headers: { Accept: "application/json" },
          body: new FormData(form),
        });

        if (response.ok) {
          form.reset();
          fieldErrors.forEach((el) => {
            el.hidden = true;
            el.textContent = "";
          });
          form
            .querySelectorAll("[aria-invalid]")
            .forEach((el) => el.removeAttribute("aria-invalid"));
          setFormStatus(
            "success",
            "お問い合わせを送信しました。内容を確認次第、ご連絡いたします。",
          );
          if (statusEl && "focus" in statusEl) {
            statusEl.focus();
          }
          return;
        }

        let errorMessage =
          "送信に失敗しました。時間をおいて再度お試しください。";
        try {
          const data = await response.json();
          if (data.error) {
            errorMessage = data.error;
          } else if (data.errors && data.errors[0] && data.errors[0].message) {
            errorMessage = data.errors[0].message;
          }
        } catch {
          /* use default message */
        }
        setFormStatus("error", errorMessage);
      } catch {
        setFormStatus(
          "error",
          "通信エラーが発生しました。ネットワーク接続をご確認のうえ、再度お試しください。",
        );
      } finally {
        setLoading(false);
      }
    });
  }
</script>

<style>
  .contact-form {
    margin-top: 1.5rem;
  }

  .contact-form__heading {
    margin: 0 0 1rem;
    font-size: 1.125rem;
    line-height: var(--line-heading);
    color: var(--text-primary);
  }

  .contact-form__form {
    max-width: var(--width-form);
  }

  .form-status {
    margin: 0 0 1rem;
    padding: 0.75rem 1rem;
    border-radius: var(--radius-sm);
    font-size: 0.95rem;
    line-height: 1.5;
  }

  .form-status.is-success {
    background: var(--callout-success-bg);
    border: 1px solid var(--callout-success-border);
    color: var(--callout-success-text);
  }

  .form-status.is-error {
    background: var(--callout-error-bg);
    border: 1px solid var(--callout-error-border);
    color: var(--callout-error-text);
  }

  .field {
    margin-bottom: 1.35rem;
  }

  .field-label {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.35rem 0.5rem;
    font-weight: 700;
    margin-bottom: 0.4rem;
    color: var(--text-primary);
    line-height: 1.4;
  }

  .field-label__required {
    display: inline-flex;
    align-items: center;
    padding: 0.1rem 0.45rem;
    border-radius: var(--radius-sm);
    background: var(--accent-soft);
    color: var(--accent);
    font-size: 0.6875rem;
    font-weight: 700;
    letter-spacing: 0.04em;
    line-height: 1.3;
  }

  input,
  textarea {
    width: 100%;
    padding: 0.75rem;
    border: 1px solid var(--border);
    border-radius: var(--radius-sm);
    font: inherit;
    font-size: max(1rem, 16px);
    line-height: 1.5;
    color: var(--text-primary);
    background: var(--bg-article);
    transition:
      border-color 0.15s ease,
      box-shadow 0.15s ease;
  }

  input:hover:not(:disabled):not([aria-invalid="true"]),
  textarea:hover:not(:disabled):not([aria-invalid="true"]) {
    border-color: var(--border-strong);
  }

  input:focus-visible,
  textarea:focus-visible {
    outline: none;
    border-color: var(--accent);
    box-shadow: 0 0 0 3px var(--accent-soft);
  }

  input[aria-invalid="true"],
  textarea[aria-invalid="true"] {
    border-color: var(--callout-error-accent);
    box-shadow: 0 0 0 3px var(--callout-error-ring);
  }

  input[aria-invalid="true"]:focus-visible,
  textarea[aria-invalid="true"]:focus-visible {
    border-color: var(--callout-error-accent);
    box-shadow:
      0 0 0 3px var(--callout-error-ring),
      0 0 0 5px var(--accent-soft);
  }

  textarea {
    min-height: 9rem;
    resize: vertical;
  }

  .field-hint {
    margin: 0.4rem 0 0;
    color: var(--text-tertiary);
    font-size: 0.85rem;
    line-height: 1.45;
  }

  .field-error {
    display: flex;
    align-items: flex-start;
    gap: 0.35rem;
    margin: 0.4rem 0 0;
    color: var(--callout-error-text);
    font-size: 0.875rem;
    line-height: 1.45;
  }

  .field-error::before {
    content: "!";
    flex-shrink: 0;
    width: 1.1rem;
    height: 1.1rem;
    border-radius: 999px;
    background: var(--callout-error-accent);
    color: #fff;
    font-size: 0.7rem;
    font-weight: 700;
    line-height: 1.1rem;
    text-align: center;
  }

  button {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 0.5rem;
    min-height: var(--cta-min-height);
    min-width: 8rem;
    background: var(--accent);
    color: var(--text-on-accent);
    border: 0;
    border-radius: var(--cta-radius);
    padding: var(--cta-padding-y) var(--cta-padding-x);
    font: inherit;
    font-size: var(--cta-font-size);
    font-weight: var(--cta-font-weight);
    cursor: pointer;
    transition:
      var(--cta-transition),
      opacity 0.15s ease,
      box-shadow 0.15s ease;
  }

  button:hover:not(:disabled) {
    background: var(--accent-hover);
  }

  button:focus-visible {
    outline: none;
    box-shadow: 0 0 0 3px var(--accent-soft);
  }

  button:disabled {
    opacity: 0.78;
    cursor: wait;
  }

  .btn-loading {
    display: inline-flex;
    align-items: center;
    gap: 0.45rem;
    letter-spacing: 0.02em;
  }

  .btn-spinner {
    width: 1rem;
    height: 1rem;
    border: 2px solid color-mix(in srgb, var(--text-on-accent) 35%, transparent);
    border-top-color: var(--text-on-accent);
    border-radius: 50%;
    animation: contact-form-spin 0.75s linear infinite;
  }

  @keyframes contact-form-spin {
    to {
      transform: rotate(360deg);
    }
  }

  .notice {
    color: var(--muted);
  }

  @media (max-width: 640px) {
    .contact-form__form {
      max-width: none;
    }

    button {
      width: 100%;
    }
  }
</style>
