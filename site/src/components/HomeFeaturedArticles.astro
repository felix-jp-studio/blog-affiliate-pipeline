---
import type { CollectionEntry } from "astro:content";
import ArticleCard from "./ArticleCard.astro";
import { getReadingTimeForEntry } from "../utils/article-meta";

interface Props {
  articles: CollectionEntry<"articles">[];
}

const { articles } = Astro.props;
---

{
  articles.length > 0 && (
    <section class="home-featured" aria-labelledby="home-featured-title">
      <h2 id="home-featured-title">おすすめ記事</h2>
      <p class="home-featured__lead">
        カテゴリごとの代表記事です。比較表や手順記事から目的に合うものを選べます。
      </p>
      <div class="home-featured__grid">
        {articles.map((article) => (
          <ArticleCard
            slug={article.id}
            title={article.data.title}
            description={article.data.description}
            pubDate={article.data.pubDate}
            category={article.data.category}
            articleType={article.data.articleType}
            readingTimeMinutes={getReadingTimeForEntry(article)}
            excerpt={article.data.excerpt}
            eyecatch={article.data.eyecatch}
            variant="compact"
          />
        ))}
      </div>
    </section>
  )
}

<style>
  .home-featured {
    margin-top: 2.5rem;
    padding: 1.75rem 1.75rem 1.85rem;
    background: var(--bg-article);
    border: 1px solid var(--border);
    border-radius: var(--radius-md);
    box-shadow: var(--shadow-sm);
  }

  .home-featured h2 {
    margin: 0 0 0.5rem;
    font-size: 1.35rem;
    line-height: var(--line-heading);
  }

  .home-featured__lead {
    margin: 0 0 1.25rem;
    font-size: 0.95rem;
    line-height: 1.7;
    color: var(--text-secondary);
    max-width: var(--width-lead);
  }

  .home-featured__grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 1rem;
  }

  @media (min-width: 768px) {
    .home-featured__grid {
      grid-template-columns: repeat(4, minmax(0, 1fr));
      gap: 1.15rem;
    }
  }

  @media (max-width: 640px) {
    .home-featured {
      padding: 1.35rem 1.25rem 1.5rem;
    }

    .home-featured__grid {
      gap: 0.85rem;
    }
  }
</style>
