---
import type { CategorySlug } from "../data/category-meta";
import { categoryMeta } from "../data/category-meta";
import type { HubFeaturedArticle } from "../data/hub-article-mesh";

type FeaturedItem = HubFeaturedArticle & { category: CategorySlug };

interface Props {
  items: FeaturedItem[];
}

const { items } = Astro.props;
---

{
  items.length > 0 && (
    <section class="home-featured" aria-labelledby="home-featured-title">
      <h2 id="home-featured-title">おすすめ記事</h2>
      <p class="home-featured__lead">
        カテゴリごとの代表記事です。比較表や手順記事から目的に合うものを選べます。
      </p>
      <ul class="home-featured__list">
        {items.map((item) => (
          <li>
            <a href={`/articles/${item.slug}`}>
              <span class="home-featured__category">
                {categoryMeta[item.category].label}
              </span>
              {item.label}
            </a>
          </li>
        ))}
      </ul>
    </section>
  )
}

<style>
  .home-featured {
    margin-top: 2.5rem;
    padding: 1.5rem 1.75rem;
    background: var(--bg-article);
    border: 1px solid var(--border);
    border-radius: var(--radius-md);
  }

  .home-featured h2 {
    margin: 0 0 0.5rem;
    font-size: 1.35rem;
  }

  .home-featured__lead {
    margin: 0 0 1rem;
    font-size: 0.95rem;
    line-height: 1.7;
    color: var(--text-secondary);
  }

  .home-featured__list {
    margin: 0;
    padding: 0;
    list-style: none;
    display: grid;
    gap: 0.65rem;
  }

  .home-featured__list a {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: 0.5rem 0.75rem;
    color: var(--accent);
    font-weight: 700;
    text-decoration: none;
  }

  .home-featured__list a:hover {
    text-decoration: underline;
  }

  .home-featured__category {
    font-size: 0.75rem;
    font-weight: 700;
    color: var(--text-secondary);
    background: var(--surface);
    border: 1px solid var(--border);
    border-radius: 999px;
    padding: 0.15rem 0.55rem;
  }
</style>
