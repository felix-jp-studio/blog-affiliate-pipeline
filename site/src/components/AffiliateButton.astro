---
interface Props {
  href: string;
  label: string;
}

const { href, label } = Astro.props;
---

<a
  class="affiliate-link affiliate-button"
  href={href}
  rel="sponsored noopener noreferrer"
  target="_blank"
>
  {label}
</a>

<style>
  /* CTA 面（min-height 44px 等）は prose.css の共有 .affiliate-link 規則から継承する */
  .affiliate-button {
    margin: 0.25rem 0;
  }

  @media (max-width: 640px) {
    .affiliate-button {
      width: 100%;
    }
  }
</style>
