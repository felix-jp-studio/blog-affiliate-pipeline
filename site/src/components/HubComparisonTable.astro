---
import type {
  HubComparisonColumn,
  HubComparisonRow,
} from "../data/hub-asp-offers";

interface Props {
  title: string;
  note: string;
  columns: HubComparisonColumn[];
  rows: HubComparisonRow[];
}

const { title, note, columns, rows } = Astro.props;
---

<section class="hub-comparison" aria-labelledby="hub-comparison-title">
  <h2 id="hub-comparison-title" class="hub-comparison__title">{title}</h2>
  <div
    class="table-scroll"
    tabindex="0"
    role="region"
    aria-label={`${title}（横スクロール可能）`}
  >
    <div class="table-scroll__fade" aria-hidden="true"></div>
    <table class="hub-comparison__table">
      <thead>
        <tr>
          {columns.map((column) => <th scope="col">{column.label}</th>)}
        </tr>
      </thead>
      <tbody>
        {
          rows.map((row) => (
            <tr>
              {columns.map((column) => (
                <td>{row[column.key] ?? ""}</td>
              ))}
            </tr>
          ))
        }
      </tbody>
    </table>
    <p class="table-scroll__hint" aria-hidden="true">
      ← 横にスクロールできます →
    </p>
  </div>
  <p class="hub-comparison__note">{note}</p>
</section>

<style>
  .hub-comparison {
    display: flex;
    flex-direction: column;
    gap: 0.85rem;
  }

  .hub-comparison__title {
    margin: 0;
    font-size: 1.15rem;
    line-height: var(--line-heading);
    color: var(--text-primary);
  }

  .table-scroll {
    position: relative;
    overflow-x: auto;
    -webkit-overflow-scrolling: touch;
    border: 1px solid var(--border);
    border-radius: var(--radius-md);
    background: var(--bg-article);
    scrollbar-width: thin;
    scrollbar-color: color-mix(in srgb, var(--text-secondary) 35%, transparent)
      transparent;
  }

  .table-scroll:focus-visible {
    outline: 2px solid var(--accent);
    outline-offset: 2px;
  }

  .table-scroll__fade {
    position: absolute;
    top: 0;
    right: 0;
    width: 2.25rem;
    height: calc(100% - 1.75rem);
    pointer-events: none;
    background: linear-gradient(
      to left,
      var(--bg-article) 12%,
      color-mix(in srgb, var(--bg-article) 55%, transparent) 55%,
      transparent
    );
    z-index: 4;
  }

  .table-scroll__hint {
    margin: 0;
    text-align: center;
    font-size: 0.75rem;
    line-height: 1.2;
    color: var(--text-secondary);
    padding: 0.35rem 0.5rem 0.5rem;
    min-height: calc(0.75rem * 1.2 + 0.85rem);
  }

  @media (min-width: 641px) {
    .table-scroll__fade,
    .table-scroll__hint {
      display: none;
    }
  }

  .hub-comparison__table {
    width: 100%;
    min-width: var(--width-table-min);
    border-collapse: separate;
    border-spacing: 0;
    font-size: 0.9rem;
    line-height: 1.6;
  }

  .hub-comparison__table th,
  .hub-comparison__table td {
    padding: 0.65rem 0.85rem;
    border-bottom: 1px solid var(--border);
    text-align: left;
    vertical-align: top;
  }

  .hub-comparison__table th {
    background: var(--accent-soft);
    font-weight: 700;
    color: var(--text-primary);
    white-space: nowrap;
    position: sticky;
    top: var(--sticky-top-offset);
    z-index: 2;
    box-shadow: 0 1px 0 var(--border);
  }

  .hub-comparison__table tbody tr:last-child td {
    border-bottom: none;
  }

  .hub-comparison__table td {
    background: var(--bg-article);
  }

  @media (max-width: 640px) {
    .hub-comparison__table th:first-child,
    .hub-comparison__table td:first-child {
      position: sticky;
      left: 0;
      z-index: 1;
      box-shadow: 2px 0 6px
        color-mix(in srgb, var(--text-primary) 8%, transparent);
    }

    .hub-comparison__table th:first-child {
      z-index: 3;
    }
  }

  .hub-comparison__note {
    margin: 0;
    font-size: 0.85rem;
    line-height: 1.65;
    color: var(--text-secondary);
  }
</style>
