---
interface Props {
  slug: string;
  articleTitle: string;
}

const { slug, articleTitle } = Astro.props;
const enabled = import.meta.env.PUBLIC_COMMENTS_ENABLED === "true";
---

{
  enabled && (
    <section
      class="article-comments"
      data-article-comments
      data-article-slug={slug}
      aria-labelledby="article-comments-heading"
    >
      <h2 id="article-comments-heading" class="article-comments__heading">
        コメント
      </h2>
      <p class="article-comments__lead">
        「{articleTitle}
        」へのコメントを投稿できます。投稿は運営確認後に公開されます。
      </p>

      <div
        class="comment-status"
        role="status"
        aria-live="polite"
        tabindex="-1"
        data-comment-status
        hidden
      />

      <ol class="comment-list" data-comment-list aria-live="polite" />

      <form class="comment-form" data-comment-form novalidate>
        <div class="field field-honeypot" aria-hidden="true">
          <label for={`website-${slug}`}>Website</label>
          <input
            id={`website-${slug}`}
            name="website"
            type="text"
            tabindex="-1"
            autocomplete="off"
          />
        </div>
        <div class="field">
          <label for={`authorName-${slug}`}>お名前</label>
          <input
            id={`authorName-${slug}`}
            name="authorName"
            type="text"
            required
            maxlength="32"
            autocomplete="name"
            aria-describedby={`authorName-error-${slug}`}
          />
          <p
            class="field-error"
            id={`authorName-error-${slug}`}
            data-field-error="authorName"
            hidden
          />
        </div>
        <div class="field">
          <label for={`body-${slug}`}>コメント</label>
          <textarea
            id={`body-${slug}`}
            name="body"
            rows="4"
            required
            minlength="10"
            maxlength="1000"
            aria-describedby={`body-error-${slug} body-hint-${slug}`}
          />
          <p class="field-hint" id={`body-hint-${slug}`}>
            10文字以上、1,000文字以内。荒らし・誹謗中傷は削除します。
          </p>
          <p
            class="field-error"
            id={`body-error-${slug}`}
            data-field-error="body"
            hidden
          />
        </div>
        <button type="submit" class="btn btn-primary" data-submit-button>
          <span class="btn-label">コメントを送信</span>
          <span class="btn-loading" hidden>
            送信中…
          </span>
        </button>
      </form>
    </section>
  )
}

{enabled && <script src="./article-comments-client.ts" />}

<style>
  .article-comments {
    margin: 2rem 1.25rem 0;
    padding-top: 1.5rem;
    border-top: 1px solid var(--border);
    content-visibility: auto;
    contain-intrinsic-size: auto 420px;
  }

  .article-comments__heading {
    font-size: 1.25rem;
    margin: 0 0 0.5rem;
  }

  .article-comments__lead {
    color: var(--text-muted);
    font-size: 0.9375rem;
    margin: 0 0 1.25rem;
  }

  .comment-status {
    margin-bottom: 1rem;
    padding: 0.75rem 1rem;
    border-radius: var(--radius-sm);
    font-size: 0.9375rem;
  }

  .comment-status.is-success {
    background: var(--callout-success-bg);
    color: var(--callout-success-text);
    border: 1px solid var(--callout-success-border);
  }

  .comment-status.is-error {
    background: var(--callout-error-bg);
    color: var(--callout-error-text);
    border: 1px solid var(--callout-error-border);
  }

  .comment-list {
    list-style: none;
    margin: 0 0 1.5rem;
    padding: 0;
    display: flex;
    flex-direction: column;
    gap: 1rem;
  }

  .comment-list__empty {
    color: var(--text-muted);
    font-size: 0.9375rem;
  }

  .comment-item {
    background: var(--bg-subtle, #f8fafc);
    border: 1px solid var(--border);
    border-radius: var(--radius-sm);
    padding: 0.875rem 1rem;
  }

  .comment-item__meta {
    font-size: 0.8125rem;
    color: var(--text-muted);
    margin: 0 0 0.375rem;
  }

  .comment-item__body {
    margin: 0;
    white-space: pre-wrap;
    word-break: break-word;
  }

  .comment-form {
    display: flex;
    flex-direction: column;
    gap: 1rem;
  }

  .field label {
    display: block;
    font-weight: 700;
    margin-bottom: 0.375rem;
    font-size: 0.9375rem;
  }

  .field input,
  .field textarea {
    width: 100%;
    box-sizing: border-box;
    padding: 0.625rem 0.75rem;
    border: 1px solid var(--border);
    border-radius: var(--radius-sm);
    font: inherit;
    font-size: max(1rem, 16px);
    line-height: 1.5;
    color: var(--text-primary);
    background: var(--bg-article);
  }

  .field input:focus,
  .field textarea:focus {
    outline: none;
    border-color: var(--accent);
    box-shadow: 0 0 0 3px var(--accent-soft);
  }

  .field-honeypot {
    position: absolute;
    left: -9999px;
    height: 0;
    overflow: hidden;
  }

  .field-hint {
    font-size: 0.8125rem;
    color: var(--text-muted);
    margin: 0.375rem 0 0;
  }

  .field-error {
    color: var(--callout-error-text);
    font-size: 0.8125rem;
    margin: 0.375rem 0 0;
  }

  .btn-primary {
    align-self: flex-start;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-height: var(--cta-min-height);
    padding: var(--cta-padding-y) var(--cta-padding-x);
    border: none;
    border-radius: var(--cta-radius);
    background: var(--accent);
    color: var(--text-on-accent);
    font-size: var(--cta-font-size);
    font-weight: var(--cta-font-weight);
    cursor: pointer;
    transition:
      var(--cta-transition),
      opacity 0.15s ease;
  }

  .btn-primary:hover:not(:disabled) {
    background: var(--accent-hover);
  }

  .btn-primary:disabled {
    opacity: 0.7;
    cursor: not-allowed;
  }
</style>
