---
import { getCollection } from "astro:content";
import CategoryHub from "../components/CategoryHub.astro";
import { categoryMeta } from "../data/category-meta";
import { buildBreadcrumbs } from "../data/site-nav";
import BaseLayout from "../layouts/BaseLayout.astro";
import { buildBreadcrumbJsonLd } from "../utils/breadcrumb-jsonld";
import { compareArticlesByRecency } from "../utils/sort-articles";

const meta = categoryMeta.cost;

const articles = (await getCollection("articles", ({ data }) => !data.draft))
  .filter((a) => a.data.category === "cost")
  .sort(compareArticlesByRecency);

const jsonLd = buildBreadcrumbJsonLd(
  buildBreadcrumbs([{ label: meta.label, href: meta.href }]),
  Astro.site!.href,
);
---

<BaseLayout
  title={meta.label}
  description={meta.description}
  layout="hub"
  activeNav="cost"
  ogImage={meta.ogImage}
  jsonLd={jsonLd}
>
  <CategoryHub category="cost" articles={articles} />
</BaseLayout>
