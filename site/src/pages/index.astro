---
import { getCollection } from "astro:content";
import ArticleCard from "../components/ArticleCard.astro";
import { defaultOgImage } from "../data/category-meta";
import { getReadingTimeForEntry } from "../utils/article-meta";
import { compareArticlesByRecency } from "../utils/sort-articles";
import BaseLayout from "../layouts/BaseLayout.astro";

const latestArticles = (
  await getCollection("articles", ({ data }) => !data.draft)
)
  .sort(compareArticlesByRecency)
  .slice(0, 6);
---

<BaseLayout title="SIM・光回線ガイド" ogImage={defaultOgImage}>
  <section class="home-hero">
    <p class="badge">記事公開中</p>
    <h1>格安SIM・光回線の比較とお困り解決</h1>
    <p class="lead">
      乗り換え手順、料金比較、速度トラブルの対処法など、通信まわりの情報をわかりやすくまとめます。
    </p>
  </section>

  <section class="latest-articles">
    <h2>最新記事</h2>
    <div class="latest-articles__grid">
      {
        latestArticles.map((article) => (
          <ArticleCard
            slug={article.id}
            title={article.data.title}
            description={article.data.description}
            pubDate={article.data.pubDate}
            category={article.data.category}
            articleType={article.data.articleType}
            readingTimeMinutes={getReadingTimeForEntry(article)}
            excerpt={article.data.excerpt}
            eyecatch={article.data.eyecatch}
          />
        ))
      }
    </div>
  </section>

  <section class="category-section">
    <h2>カテゴリから探す</h2>
    <div class="card-grid">
      <section class="card card--category card--sim">
        <h2>格安SIM</h2>
        <p>
          乗り換え・MNP・料金比較など、格安SIMに関する記事を掲載しています。
        </p>
        <a href="/sim">カテゴリを見る</a>
      </section>
      <section class="card card--category card--hikari">
        <h2>光回線</h2>
        <p>
          NURO光・auひかりなど、光回線の比較とセット割情報を掲載しています。
        </p>
        <a href="/hikari">カテゴリを見る</a>
      </section>
      <section class="card card--category card--cost">
        <h2>固定費・ライフイベント</h2>
        <p>
          電気×通信セット、引越し時の見直しなど、固定費と通信を横断する記事です。
        </p>
        <a href="/cost">カテゴリを見る</a>
      </section>
      <section class="card card--category card--trouble">
        <h2>お困り系</h2>
        <p>
          速度が遅い、開通が遅いなど、よくある悩みへの対処法を掲載しています。
        </p>
        <a href="/trouble">カテゴリを見る</a>
      </section>
    </div>
  </section>
</BaseLayout>

<style>
  .home-hero {
    background: var(--bg-home-hero);
    border-radius: var(--radius-md);
    padding: 2rem 2.25rem;
    margin-bottom: 0.5rem;
  }

  .home-hero h1 {
    margin-top: 0;
  }

  .latest-articles {
    margin-top: 2.5rem;
  }

  .latest-articles h2,
  .category-section h2 {
    margin-top: 0;
    font-size: 1.35rem;
  }

  .latest-articles__grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: 1.25rem;
    margin-top: 1.25rem;
  }

  .category-section {
    margin-top: 3rem;
  }

  .card--category {
    border-left: 4px solid var(--category-accent, var(--accent));
    background:
      linear-gradient(
        180deg,
        color-mix(in srgb, var(--category-accent, var(--accent)) 10%, transparent)
          0%,
        transparent 2.5rem
      ),
      var(--bg-article);
  }

  .card--category h2 {
    color: var(--category-accent, var(--text-primary));
  }

  .card--sim {
    --category-accent: var(--color-sim);
  }

  .card--hikari {
    --category-accent: var(--color-hikari);
  }

  .card--cost {
    --category-accent: var(--color-cost);
  }

  .card--trouble {
    --category-accent: var(--color-trouble);
  }

  @media (max-width: 640px) {
    .home-hero {
      padding: 1.5rem 1.25rem;
    }
  }

  @media (min-width: 768px) {
    .latest-articles__grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }
</style>
