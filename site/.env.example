# サイト用環境変数（Vercel に設定。ローカル検証時は .env にコピー）

PUBLIC_GA_MEASUREMENT_ID=
PUBLIC_GSC_VERIFICATION=
PUBLIC_CONTACT_FORM_ACTION=
PUBLIC_CONTACT_EMAIL=

# 記事コメント（Vercel KV + serverless API）
PUBLIC_COMMENTS_ENABLED=false
COMMENTS_MODERATOR_TOKEN=
COMMENTS_IP_SALT=
# KV_REST_API_URL / KV_REST_API_TOKEN は Vercel KV 連携で自動注入

# 有料記事（Stripe 単品買い切り + Vercel KV）
PUBLIC_PAYWALL_ENABLED=false
STRIPE_SECRET_KEY=
# 購入者 cookie の署名鍵。openssl rand -base64 32 などで生成し、変更すると既存購入者の cookie が失効する
PAYWALL_TOKEN_SECRET=
# Stripe webhook（/api/paywall/webhook）の署名シークレット。whsec_... 未設定だと webhook は 503 を返す
STRIPE_WEBHOOK_SECRET=
